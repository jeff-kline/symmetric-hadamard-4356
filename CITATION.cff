        given-names: Albert Leon
    journal: "Bulletin of the Australian Mathematical Society"
    volume: 7
    year: 1972
    doi: 10.1017/S0004972700044993
  - type: generic
    title: "Census of symmetric and skew Hadamard matrices of order 4v for odd v < 2500"
    authors:
